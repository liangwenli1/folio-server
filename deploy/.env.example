# Copy to .env next to docker-compose.yml and fill in. Keep .env private: it holds every key Folio has.

# The domain Cloudflare serves (no https://), and the port on this server Cloudflare connects to.
FOLIO_DOMAIN=folio.example.com
FOLIO_PORT=8080

# Where the images are: ghcr.io/<GHCR_OWNER>/folio-server and folio-site. Your GitHub user or organization, in
# lower case. FOLIO_VERSION: latest (the newest v* tag), a version such as v0.1.0, or main.
GHCR_OWNER=your-github-name
FOLIO_VERSION=latest

# Database password, letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=

# 32 random bytes, base64: openssl rand -base64 32
# Proxy passwords, saved sign-ins and extension signatures depend on it. Never change it once Folio is in use.
SECRET_KEY=

# Cloudflare R2: create a bucket, then an API token with Object Read & Write on it.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=folio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Outgoing mail (sign-up codes, password resets, invitations), any SMTP provider. Folio won't start without it.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Folio <no-reply@folio.example.com>

# Leave empty: there is no real payment gateway yet, so paid plans show as coming soon.
MOCK_PAYMENTS=
